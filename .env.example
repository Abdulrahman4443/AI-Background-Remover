# ============================================================
# AI Background Remover — Master Environment Reference
#
# This file documents ALL environment variables used across
# the entire project. Each submodule has its own .env file:
#
#   backend/.env   ← copy from backend/.env.example
#   AI/.env        ← copy from AI/.env.example
#   frontend/.env  ← copy from frontend/.env.example (optional)
#
# Quick start:
#   cp backend/.env.example backend/.env
#   cp AI/.env.example      AI/.env
#   # Edit backend/.env — set SECRET_KEY and GEMINI_API_KEY at minimum
# ============================================================


# ============================================================
# BACKEND (backend/.env)
# ============================================================

# ----- Server -----
PORT=8000
# Comma-separated list of allowed CORS origins.
# In development: http://localhost:5173
# In production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# ----- MongoDB -----
# Local development:
MONGO_URI=mongodb://localhost:27017
# MongoDB Atlas (cloud):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=ai_bg_remover

# ----- Authentication -----
# REQUIRED: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate-with-python-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Development: COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production (HTTPS only): COOKIE_SECURE=true, COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ----- Quota -----
# Max AI operations per user per UTC day. Set to 0 to disable quota enforcement.
DAILY_QUOTA_LIMIT=100

# ----- File Cleanup -----
# How long processed files are kept before automatic deletion.
FILE_MAX_AGE_HOURS=24
# How often the cleanup sweep runs (in minutes).
CLEANUP_INTERVAL_MINS=60

# ----- AI Provider -----
# Supported: gemini (default), groq
AI_PROVIDER=gemini

# ----- Gemini (Google AI) -----
# Required when AI_PROVIDER=gemini.
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Override the model used for chat and vision tasks (both default to gemini-2.0-flash)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash

# ----- Groq -----
# Required when AI_PROVIDER=groq.
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Override the default model tiers:
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ----- Storage -----
# STORAGE_BACKEND=local     → saves processed images to backend/output/ (default)
# STORAGE_BACKEND=s3        → uploads to S3-compatible object storage
STORAGE_BACKEND=local

# Required when STORAGE_BACKEND=s3:
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY=AKIAxxxxxxxxxxxxxxxx
# S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_ENDPOINT_URL=                # Leave blank for AWS S3.
#                                 # Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
#                                 # MinIO:         http://localhost:9000
# S3_PUBLIC_URL=                  # Optional CDN prefix for public URLs


# ============================================================
# AI PIPELINE (AI/.env)
# ============================================================

# Which segmentation backend to use: rembg (default), onnx, torch
MODEL_BACKEND=rembg

# Default quality tier (rembg only): fast, standard, quality
DEFAULT_QUALITY=fast

# Path to ONNX model weights (only used when MODEL_BACKEND=onnx)
ONNX_MODEL_PATH=models/model.onnx

# Path to PyTorch model weights (only used when MODEL_BACKEND=torch)
TORCH_MODEL_PATH=models/model.pth

# Model input resolution in pixels (default 1024 for all supported models)
MODEL_INPUT_SIZE=1024


# ============================================================
# FRONTEND (frontend/.env)
# ============================================================

# API base URL — only needed for production builds.
# Leave commented out in development (Vite proxy handles /api → backend).
# VITE_API_BASE_URL=https://api.yourdomain.com

# Feature flags
# VITE_ENABLE_BATCH_UPLOAD=false
# VITE_ENABLE_AUTH=true

# App name shown in browser tab and PWA manifest
# VITE_APP_NAME=AI Background Remover
